        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured Image",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text"
        },
        {
          "slug": "show_date",
          "label": "Show published date",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "slug": "show_categories",
          "label": "Show categories",
          "type": "boolean",
          "defaultValue": true
        }
      ]
    },
    {
      "slug": "testimonials",
      "label": "Testimonials",
      "labelSingular": "Testimonial",
      "supports": [
        "drafts"
      ],
      "routable": false,
      "fields": [
        {
          "slug": "title",
          "label": "Headline",
          "type": "string",
          "required": true
        },
        {
          "slug": "label",
          "label": "Small label above headline",
          "type": "string",
          "defaultValue": "Client Successes"
        },
        {
          "slug": "quote",
          "label": "Quote",
          "type": "text",
          "required": true
        },
        {
          "slug": "name",
          "label": "Client name",
          "type": "string",
          "required": true
        },
        {
          "slug": "order",
          "label": "Sort order",
          "type": "integer",
          "defaultValue": 0
        }
      ]
    },
    {
      "slug": "homepage",
      "label": "Homepage",
      "labelSingular": "Homepage",
