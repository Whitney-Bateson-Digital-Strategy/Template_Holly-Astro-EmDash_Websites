  "settings": {
    "title": "Brand Name",
    "tagline": "Personalized nutrition that fits your life"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "scheduling",
        "search",
        "seo"
      ],
      "urlPattern": "/blog/{slug}",
