      "collections": [
        "posts"
      ],
      "terms": [
        {
          "slug": "nutrition",
          "label": "Nutrition"
        },
        {
          "slug": "recipes",
          "label": "Recipes"
        },
        {
          "slug": "gut-health",
          "label": "Gut Health"
        },
        {
          "slug": "lifestyle",
          "label": "Lifestyle"
        }
