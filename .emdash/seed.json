  "widgetAreas": [
    {
      "name": "blog-sidebar",
      "label": "Blog Sidebar",
      "description": "Boxes beside every blog post. Add, remove or drag to reorder.",
      "widgets": [
        {
          "type": "component",
          "componentId": "core:search",
          "props": {
            "placeholder": "SEARCH"
          }
        },
        {
          "type": "content",
          "title": "Meet the Author",
          "content": [
            {
              "_type": "block",
              "_key": "w0",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "ws0",
                  "text": "A two- or three-sentence bio: who you help, what you specialize in, and a warm personal touch.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "w1",
              "style": "normal",
              "markDefs": [
                {
                  "_type": "link",
                  "_key": "l1",
                  "href": "/about"
                }
              ],
              "children": [
                {
                  "_type": "span",
                  "_key": "ws1",
                  "text": "Learn more about me →",
                  "marks": [
                    "l1"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "component",
          "title": "View categories",
          "componentId": "core:categories",
          "props": {
            "showCount": false
          }
        },
        {
          "type": "content",
          "title": "Download my free guide",
          "content": [
