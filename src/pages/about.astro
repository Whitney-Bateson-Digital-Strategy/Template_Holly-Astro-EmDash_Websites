---
import BaseLayout from "../layouts/BaseLayout.astro";
import SplitSection from "../components/SplitSection.astro";
import CheckList from "../components/CheckList.astro";
import LinkCards from "../components/LinkCards.astro";
import CTABand from "../components/CTABand.astro";
import { about as a } from "../data/about";
---

<BaseLayout title={a.seo.title} description={a.seo.description || undefined}>
  <!-- Intro: photo to the screen edge -->
  <SplitSection image={a.intro.image} imageSide="left" class="" fullBleed ratio="1943/1284" textClass="md:max-w-[680px]">
    <p class="eyebrow-italic">{a.intro.eyebrow}</p>
    <h1 class="mt-4">{a.intro.title}</h1>
    <p class="mt-5 text-[1.1875rem] leading-relaxed">{a.intro.body}</p>
    <a href={a.intro.cta.href} class="btn mt-8 self-start">{a.intro.cta.label}</a>
  </SplitSection>

  <!-- Story + Philosophy (with pull quote) -->
  <section class="section bg-sand">
    <div class="container-site grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="!font-body !text-xl !leading-normal font-medium">{a.story.title}</h2>
        {a.story.paragraphs.map((t) => <p class="mt-4 leading-relaxed">{t}</p>)}
      </div>
      <div>
        <h2 class="!font-body !text-xl !leading-normal font-medium">{a.philosophy.title}</h2>
        {a.philosophy.before.map((t) => <p class="mt-4 leading-relaxed">{t}</p>)}
        <blockquote class="my-6 font-display text-xl italic leading-snug text-primary">“{a.philosophy.quote}”</blockquote>
        {a.philosophy.after.map((t) => <p class="mt-4 leading-relaxed">{t}</p>)}
      </div>
    </div>
  </section>

  <div class="pt-16 md:pt-20"><CTABand /></div>

  <!-- Fun facts -->
  <SplitSection image={a.funFacts.image} imageSide="right" ratio="1563/1409" class="pb-8 md:pb-10">
    <h2 class="uppercase">{a.funFacts.title}</h2>
    <p class="mt-2 text-lg font-medium">{a.funFacts.subtitle}</p>
    <CheckList items={a.funFacts.items} class="mt-6" markClass="text-primary" />
  </SplitSection>

  <!-- Education -->
  <SplitSection image={a.education.image} imageSide="left" ratio="1563/1409" class="pb-16 md:pb-20">
    <h2 class="uppercase">{a.education.title}</h2>
    <p class="mt-3 text-lg font-medium">{a.education.subtitle}</p>
    <p class="mt-4 leading-relaxed">{a.education.body}</p>
  </SplitSection>

  <LinkCards {...a.explore} />
</BaseLayout>
