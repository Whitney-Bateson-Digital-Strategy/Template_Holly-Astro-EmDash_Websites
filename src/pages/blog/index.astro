---
/** Blog index (T1 layout): solid teal banner, 3-column grid, page numbers. Supports ?q= search and ?category= / ?tag= / ?date= filters (used by the sidebar widgets). */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import PostCard from "../../components/PostCard.astro";
import { findPosts, getCategories, getTags, getArchives } from "../../lib/cms";

const PER_PAGE = 9;
const url = Astro.url;
const q = url.searchParams.get("q") ?? "";
const category = url.searchParams.get("category") ?? "";
const tag = url.searchParams.get("tag") ?? "";
const date = url.searchParams.get("date") ?? "";
const page = Math.max(1, Number(url.searchParams.get("page")) || 1);

const posts = await findPosts({ q, category, tag, date });
const pages = Math.max(1, Math.ceil(posts.length / PER_PAGE));
const shown = posts.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const filterLabel = q
  ? `Results for “${q}”`
  : category
    ? `Category: ${(await getCategories()).find((c) => c.slug === category)?.name ?? category}`
    : tag
      ? `Tag: ${(await getTags()).find((t) => t.slug === tag)?.name ?? tag}`
      : date
        ? `Posts from ${(await getArchives(date.length === 4 ? "yearly" : "monthly", 1000)).find((a) => a.key === date)?.label ?? date}`
        : "";

const href = (n: number) => {
  const p = new URLSearchParams();
  if (q) p.set("q", q);
  if (category) p.set("category", category);
  if (tag) p.set("tag", tag);
  if (date) p.set("date", date);
  if (n > 1) p.set("page", String(n));
  const s = p.toString();
  return s ? `/blog?${s}` : "/blog";
};
---

<BaseLayout title="Blog">
  <PageBanner title="The Blog" />
  <section class="section">
    <div class="container-site">
      {
        filterLabel && (
          <p class="mb-8 text-center">
            {filterLabel} · <a href="/blog" class="text-primary underline underline-offset-4">View all posts</a>
          </p>
        )
      }
      {
        shown.length ? (
          <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 md:grid-cols-3">{shown.map((post) => <PostCard post={post} level={2} />)}</div>
        ) : (
          <p class="text-center">No posts found. Add one at <a href="/_emdash/admin" class="underline">/_emdash/admin</a>.</p>
        )
      }
      {
        pages > 1 && (
          <nav aria-label="Pages" class="mt-14 flex items-center justify-center gap-3 text-sm font-medium">
            {Array.from({ length: pages }, (_, n) => n + 1).map((n) => (
              <a
                href={href(n)}
                aria-current={n === page ? "page" : undefined}
                class:list={["flex h-8 w-8 items-center justify-center rounded-full no-underline", n === page ? "bg-accent text-ink" : "hover:text-secondary"]}
              >{n}</a>
            ))}
            {page < pages && <a href={href(page + 1)} class="px-2 no-underline hover:text-secondary" aria-label="Next page">›</a>}
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>
