---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../lib/cms";
const posts = await getPosts();
---

<BaseLayout title="Blog">
  <PageBanner title="The Blog" image={{ label: "Blog banner" }} />
  <section class="section">
    <div class="container-site">
      {
        posts.length ? (
          <div class="grid gap-12 md:grid-cols-3">{posts.map((post) => <PostCard post={post} />)}</div>
        ) : (
          <p class="text-center">No posts yet. Add one at <a href="/_emdash/admin" class="underline">/_emdash/admin</a>.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
