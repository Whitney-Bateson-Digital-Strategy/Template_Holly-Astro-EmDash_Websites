---
/** Blog post (T1 layout): teal title panel beside the featured photo, article + sidebar, CTA, prev/next. */
import { PortableText } from "emdash/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostImage from "../../components/PostImage.astro";
import BlogSidebar from "../../components/BlogSidebar.astro";
import Button from "../../components/Button.astro";
import { getPost, getPosts, getPostCategories, getSite } from "../../lib/cms";

const { slug } = Astro.params;
const post = slug ? await getPost(slug) : null;
if (!post) return Astro.rewrite("/404");

const [all, categories, siteContent] = await Promise.all([getPosts(), getPostCategories(post.id), getSite()]);
// The "let's work together" box after each post: EmDash → Site-wide content
const cta = siteContent.data as Record<string, string>;
const ce = siteContent.edit;
const i = all.findIndex((p) => p.slug === post.slug);
const newer = i > 0 ? all[i - 1] : undefined;
const older = i >= 0 && i < all.length - 1 ? all[i + 1] : undefined;
const date = post.date?.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
// Per-post checkboxes in the EmDash editor: "Show published date" / "Show categories"
const showDate = post.showDate && !!date;
const showCats = post.showCategories && categories.length > 0;
---

<BaseLayout title={post.title} description={post.excerpt || undefined}>
  <!-- Title panel + featured photo -->
  <section class="grid md:grid-cols-[40%_60%]">
    <div class="order-2 flex flex-col justify-center bg-primary px-5 py-12 text-paper md:order-1 md:py-20 md:pr-12 md:pl-[max(1.25rem,calc((100vw-var(--container-site))/2))]">
      <p class="eyebrow-script !text-[2rem] text-accent">the blog</p>
      <h1 class="mt-2 text-paper md:!text-[2.75rem] md:!leading-[1.2]">{post.title}</h1>
      {
        (showDate || showCats) && (
          <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-paper/25 pt-6 text-sm font-bold uppercase tracking-[1px]">
            {showDate && <p>Published <time datetime={post.date!.toISOString()}>{date}</time></p>}
            {showDate && showCats && <span aria-hidden="true" class="text-accent">•</span>}
            {showCats && (
              <p>{categories.map((c, n) => <>{n > 0 && ", "}<a href={`/blog?category=${c.slug}`} class="text-accent no-underline hover:text-paper">{c.name}</a></>)}</p>
            )}
          </div>
        )
      }
    </div>
    <!-- Featured image: 1143 x 754 px -->
    <div class="order-1 aspect-[1143/754] md:order-2 [&_figure]:h-full [&_picture]:h-full"><PostImage image={post.image} label="Featured image" eager /></div>
  </section>

  <div class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-16">
      <article>
        <div class="prose-site text-[17px] leading-relaxed">
          {post.content ? <PortableText value={post.content as any} /> : null}
        </div>

        <!-- In-post CTA -->
        <div class="mt-12 bg-primary px-6 py-10 text-center text-paper shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
          <p class="eyebrow-script !text-[2rem] text-accent" {...ce.attrs("post_cta_eyebrow")}>{cta.post_cta_eyebrow}</p>
          <p class="mt-2 text-xl font-medium" {...ce.attrs("post_cta_title")}>{cta.post_cta_title}</p>
          <Button label={cta.post_cta_button_label} href={cta.post_cta_button_link} edit={ce} labelField="post_cta_button_label" linkField="post_cta_button_link" class="btn mt-6" linkClass="mx-auto" />
        </div>

        <!-- Previous / next -->
        <nav aria-label="More posts" class="mt-10 flex items-center justify-between border-y border-ink/20 py-5 text-sm font-bold uppercase tracking-[1px]">
          {older ? <a href={`/blog/${older.slug}`} class="no-underline hover:text-secondary">‹ Previous post</a> : <span />}
          {newer ? <a href={`/blog/${newer.slug}`} class="no-underline hover:text-secondary">Next post ›</a> : <span />}
        </nav>
      </article>

      <BlogSidebar currentSlug={post.slug} />
    </div>
  </div>
</BaseLayout>
