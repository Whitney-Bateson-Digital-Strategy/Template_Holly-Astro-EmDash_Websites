---
import { PortableText } from "emdash/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostImage from "../../components/PostImage.astro";
import BlogSidebar from "../../components/BlogSidebar.astro";
import CTABand from "../../components/CTABand.astro";
import { getPost } from "../../lib/cms";

const { slug } = Astro.params;
const post = slug ? await getPost(slug) : null;
if (!post) return Astro.rewrite("/404");
const date = post.date?.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<BaseLayout title={post.title} description={post.excerpt || undefined}>
  <div class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-16">
      <article>
        <header>
          {date && <p class="text-sm uppercase tracking-[0.7px] text-primary/80"><time datetime={post.date!.toISOString()}>{date}</time></p>}
          <h1 class="mt-3">{post.title}</h1>
        </header>
        <div class="mt-8 h-[260px] md:h-[400px]"><PostImage image={post.image} label="Featured image" eager /></div>
        <div class="prose-site mt-10 text-[17px] leading-relaxed">
          {post.content ? <PortableText value={post.content as any} /> : null}
        </div>
        <a href="/blog" class="mt-12 inline-block text-sm uppercase tracking-[0.7px] no-underline hover:text-secondary">← Back to the blog</a>
      </article>

      <BlogSidebar />
    </div>
  </div>
  <CTABand />
</BaseLayout>
