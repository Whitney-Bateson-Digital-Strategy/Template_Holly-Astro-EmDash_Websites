---
/** Blog post (T1 layout): teal title panel beside the featured photo, article + sidebar, CTA, prev/next. */
import { PortableText } from "emdash/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostImage from "../../components/PostImage.astro";
import BlogSidebar from "../../components/BlogSidebar.astro";
import { getPost, getPosts, getPostCategories } from "../../lib/cms";
import { postCta } from "../../data/shared";

const { slug } = Astro.params;
const post = slug ? await getPost(slug) : null;
if (!post) return Astro.rewrite("/404");

const [all, categories] = await Promise.all([getPosts(), getPostCategories(post.id)]);
const i = all.findIndex((p) => p.slug === post.slug);
const newer = i > 0 ? all[i - 1] : undefined;
const older = i >= 0 && i < all.length - 1 ? all[i + 1] : undefined;
const date = post.date?.toLocaleDateString("en-US", { month: "2-digit", day: "2-digit", year: "numeric" });
---

<BaseLayout title={post.title} description={post.excerpt || undefined}>
  <!-- Title panel + featured photo -->
  <section class="grid md:grid-cols-[40%_60%]">
    <div class="order-2 flex flex-col justify-between gap-10 bg-primary px-5 py-12 text-paper md:order-1 md:py-16 md:pr-10 md:pl-[max(1.25rem,calc((100vw-var(--container-site))/2))]">
      <h1 class="!font-body !text-2xl !leading-snug !tracking-normal font-medium text-paper md:!text-[1.75rem]">{post.title}</h1>
      <div class="space-y-2 text-sm font-medium">
        {date && <p>Published on: <time datetime={post.date!.toISOString()}>{date}</time></p>}
        {categories.length > 0 && (
          <p>{categories.map((c, n) => <>{n > 0 && ", "}<a href={`/blog?category=${c.slug}`} class="no-underline hover:text-accent">{c.name}</a></>)}</p>
        )}
      </div>
    </div>
    <div class="order-1 h-[260px] md:order-2 md:h-auto md:min-h-[420px]"><PostImage image={post.image} label="Featured image" eager /></div>
  </section>

  <div class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-16">
      <article>
        <div class="prose-site text-[17px] leading-relaxed">
          {post.content ? <PortableText value={post.content as any} /> : null}
        </div>

        <!-- In-post CTA -->
        <div class="mt-12 bg-primary px-6 py-10 text-center text-paper shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
          <p class="eyebrow-script !text-[2rem] text-accent">{postCta.eyebrow}</p>
          <p class="mt-2 text-xl font-medium">{postCta.title}</p>
          <a href={postCta.cta.href} class="btn mt-6">{postCta.cta.label}</a>
        </div>

        <!-- Previous / next -->
        <nav aria-label="More posts" class="mt-10 flex items-center justify-between border-y border-ink/20 py-5 text-sm font-bold uppercase tracking-[1px]">
          {older ? <a href={`/blog/${older.slug}`} class="no-underline hover:text-secondary">‹ Previous post</a> : <span />}
          {newer ? <a href={`/blog/${newer.slug}`} class="no-underline hover:text-secondary">Next post ›</a> : <span />}
        </nav>
      </article>

      <BlogSidebar currentSlug={post.slug} />
    </div>
  </div>
</BaseLayout>
