---
/** Free guide opt-in page (T1 style). Copy: `freeGuide` in src/data/pages.ts. Form endpoint: site.optin in site.config.ts. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Media from "../components/Media.astro";
import CheckList from "../components/CheckList.astro";
import { freeGuide as g } from "../data/pages";
import { site } from "../site.config";
const f = site.optin;
---

<BaseLayout title={g.seo.title} description={g.seo.description || undefined} hideOptIn>
  <section class="bg-mist">
    <div class="grid md:grid-cols-2">
      <!-- Photo / guide mockup: 1155 x 595 px or taller -->
      <div class="relative h-[260px] md:h-auto md:min-h-[560px]">
        <div class="absolute inset-0"><Media {...g.image} eager /></div>
      </div>
      <div class="flex items-center px-5 py-14 md:px-[8%] md:py-20">
        <div class="w-full max-w-[520px]">
          <p class="eyebrow-script text-primary">{g.eyebrow}</p>
          <h1 class="mt-2 uppercase">{g.title}</h1>
          <p class="mt-4 text-lg">{g.body}</p>
          {g.bullets.length > 0 && (
            <>
              <p class="mt-6 font-medium">{g.bulletsTitle}</p>
              <CheckList items={g.bullets} class="mt-3" variant="dot" />
            </>
          )}
          <form action={f.action || "#"} method={f.method} class="mt-8 grid gap-3">
            <label class="sr-only" for="fg-name">First name</label>
            <input id="fg-name" class="field !bg-paper" type="text" name={f.nameField} placeholder="First Name" autocomplete="given-name" />
            <label class="sr-only" for="fg-email">Email</label>
            <input id="fg-email" class="field !bg-paper" type="email" name={f.emailField} placeholder="Email" autocomplete="email" required />
            <button class="btn" type="submit">{g.button}</button>
          </form>
          {g.fineprint && <p class="mt-2 text-[13px] text-ink/70">{g.fineprint}</p>}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
