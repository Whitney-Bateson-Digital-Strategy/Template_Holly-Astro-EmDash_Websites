---
/** Home (T1 V1). Copy lives in src/data/home.ts; offer rows come from src/data/offers.ts. */
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import ServiceRows from "../components/ServiceRows.astro";
import SplitSection from "../components/SplitSection.astro";
import Testimonials from "../components/Testimonials.astro";
import Newsletter from "../components/Newsletter.astro";
import StepsBand from "../components/StepsBand.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { home } from "../data/home";
const h = home;
---

<BaseLayout title={h.seo.title || undefined} description={h.seo.description || undefined}>
  <HeroBanner {...h.hero} />

  <!-- Intro -->
  <section class="section text-center">
    <div class="container-site max-w-[900px]">
      <h2 class="uppercase">{h.intro.title}</h2>
      <p class="mt-4 text-lg font-medium md:text-xl">
        {h.intro.subtitle.before}<span class="text-secondary">{h.intro.subtitle.highlight}</span>{h.intro.subtitle.after}
      </p>
      {h.intro.paragraphs.map((t) => <p class="mt-4 leading-relaxed">{t}</p>)}
    </div>
  </section>

  <ServiceRows {...h.services} />

  <Testimonials {...h.testimonials} />

  <Newsletter {...h.newsletter} />

  <SplitSection image={h.about.image} imageSide="right" ratio="1563/1126" class="pb-16 md:pb-20">
    <p class="eyebrow-script text-primary">{h.about.eyebrow}</p>
    <h2 class="mt-2 uppercase">{h.about.title}</h2>
    <p class="mt-3 text-lg font-medium">{h.about.subtitle}</p>
    <p class="mt-4 leading-relaxed">{h.about.body}</p>
    <a href={h.about.cta.href} class="btn mt-8 self-start">{h.about.cta.label}</a>
  </SplitSection>

  <StepsBand {...h.process} />

  <div class="pt-16 md:pt-20"><LatestPosts {...h.blog} /></div>
</BaseLayout>
