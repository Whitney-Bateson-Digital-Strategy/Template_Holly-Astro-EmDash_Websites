---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import Media from "../components/Media.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { contact as c } from "../data/contact";
import { offers } from "../data/offers";
import { site } from "../site.config";
---

<BaseLayout title={c.seo.title} description={c.seo.description || undefined}>
  <PageBanner {...c.banner} />

  <section class="section">
    <div class="container-site grid gap-x-16 gap-y-12 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <!-- Intro -->
      <div class="self-center">
        <p class="eyebrow-italic">{c.intro.eyebrow}</p>
        <h2 class="mt-2 uppercase">{c.intro.title}</h2>
        <p class="mt-4 leading-relaxed">{c.intro.body}</p>
        <p class="mt-5 font-medium text-primary">
          {c.intro.bookingNote.text} <a href={c.intro.bookingNote.link.href} class="underline underline-offset-4 hover:text-secondary">{c.intro.bookingNote.link.label}</a>
        </p>
      </div>

      <!-- Photo -->
      <div class="aspect-[820/835]"><Media {...c.intro.image} /></div>

      <!-- Form: labels sit inside the boxes, as in the T1 design -->
      <form action={site.contactForm.action || "#"} method={site.contactForm.method} class="contact-form grid gap-4 md:grid-cols-2">
        {
          c.form.fields.map((f) => {
            const id = `cf-${f.name}`;
            const placeholder = f.label + (f.required ? "" : " (optional)");
            return (
              <div class:list={[!f.half && "md:col-span-2"]}>
                <label for={id} class="sr-only">{f.label}</label>
                {f.type === "textarea" ? (
                  <textarea id={id} name={f.name} rows="5" class="cf-field" placeholder={placeholder} required={f.required} />
                ) : f.type === "select" ? (
                  <div class="relative">
                    <select id={id} name={f.name} class="cf-field cf-select" required={f.required}>
                      <option value="" selected disabled>{f.label}</option>
                      {offers.map((o) => <option value={o.title}>{o.title}</option>)}
                    </select>
                    <span class="pointer-events-none absolute top-1/2 right-5 -translate-y-1/2 border-x-[7px] border-t-[8px] border-x-transparent border-t-accent" aria-hidden="true" />
                  </div>
                ) : (
                  <input id={id} name={f.name} type={f.type} class="cf-field" placeholder={placeholder} required={f.required} />
                )}
              </div>
            );
          })
        }
        <div class="flex justify-end md:col-span-2"><button type="submit" class="btn">{c.form.button}</button></div>
      </form>

      <!-- Socials -->
      <aside>
        <p class="eyebrow-italic">{c.socialTitle}</p>
        <ul class="mt-4 space-y-4">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" class="group flex items-center gap-4 no-underline">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-paper transition-colors group-hover:bg-secondary"><SocialIcon name={s.label} class="h-4 w-4" /></span>
                  <span class="flex flex-col">
                    <span class="font-medium group-hover:text-secondary">{s.label}</span>
                    <span class="text-sm text-ink/70">{s.handle}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .cf-field {
    width: 100%;
    background: #f4f8fc;
    border: 0;
    padding: 1.1rem 1.25rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.875rem;
  }
  .cf-field::placeholder,
  .cf-select:invalid {
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .cf-select { appearance: none; padding-right: 3rem; cursor: pointer; }
  .cf-field:focus { outline: 2px solid var(--color-secondary); outline-offset: 0; }
</style>
