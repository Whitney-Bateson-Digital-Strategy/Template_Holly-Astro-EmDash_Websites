---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import { booking as b } from "../data/contact";
import { site } from "../site.config";
---

<BaseLayout title={b.seo.title} description={b.seo.description || undefined}>
  <PageBanner {...b.banner} />
  <section class="section">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow-script text-accent">{b.intro.eyebrow}</p>
      <h2 class="mt-2">{b.intro.title}</h2>
      <p class="mt-4 leading-relaxed">{b.intro.body}</p>
    </div>
    <div class="container-site mt-10 max-w-4xl">
      {
        site.bookingEmbedUrl ? (
          <iframe src={site.bookingEmbedUrl} title="Book a call" class="h-[760px] w-full border-0" loading="lazy" />
        ) : (
          <div class="flex h-[420px] items-center justify-center border-2 border-dashed border-ink/20 bg-mist text-center text-ink/60">
            <p>Booking calendar embed goes here.<br />Set <code>bookingEmbedUrl</code> in <code>src/site.config.ts</code>.</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
