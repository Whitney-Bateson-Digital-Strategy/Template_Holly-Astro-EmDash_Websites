---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="container-site max-w-2xl py-16 text-center">
      <p class="eyebrow-script text-accent">oops!</p>
      <h1 class="mt-2">We can't find that page</h1>
      <p class="mt-4">It may have moved. Try the home page or get in touch.</p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="/" class="btn">Go home</a>
        <a href="/contact" class="btn btn-gold">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
