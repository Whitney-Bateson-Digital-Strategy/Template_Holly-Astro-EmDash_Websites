---
/** Teal band with three numbered steps and a button ("How to get started"). */
import EditLink from "./EditLink.astro";
import type { EditAttrs, Link } from "../data/types";
type Edit<K extends string> = Partial<Record<K, EditAttrs>>;
/** `edit` / items[].edit = on-page editing attributes per prop */
interface Props {
  eyebrow?: string;
  title: string;
  items: { label: string; title: string; body: string; edit?: Edit<"label" | "title" | "body"> }[];
  cta?: Link;
  edit?: Edit<"eyebrow" | "title" | "ctaLabel" | "ctaHref">;
}
const { eyebrow, title, items, cta, edit = {} } = Astro.props;
---

<section class="bg-primary py-16 text-center text-paper md:py-20">
  <div class="container-site">
    {eyebrow && <p class="text-sm font-bold uppercase tracking-[1px]" {...edit.eyebrow}>{eyebrow}</p>}
    <h2 class="mt-2 text-paper uppercase" {...edit.title}>{title}</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-3">
      {
        items.map((s) => (
          <div>
            <p class="eyebrow-script !text-[2rem] text-accent" {...s.edit?.label}>{s.label}</p>
            <h3 class="mt-1 !font-body !text-lg !not-italic font-medium" {...s.edit?.title}>{s.title}</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm text-paper/85" {...s.edit?.body}>{s.body}</p>
          </div>
        ))
      }
    </div>
    {cta && <a href={cta.href} class="btn mt-10"><span {...edit.ctaLabel}>{cta.label}</span></a>}
    {cta && <EditLink attrs={edit.ctaHref} href={cta.href} class="mx-auto" />}
  </div>
</section>
