---
interface Props { items: readonly string[]; class?: string; markClass?: string }
const { items, class: className = "", markClass = "text-accent" } = Astro.props;
---

<ul class:list={["space-y-3", className]}>
  {
    items.map((item) => (
      <li class="flex gap-3">
        <svg class:list={["mt-1 h-4 w-4 shrink-0", markClass]} viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2.5 8.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
        </svg>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
