---
/** Bulleted list. variant "check" = check marks, "dot" = small dots (T1 offer/program lists). */
interface Props { items: readonly string[]; class?: string; markClass?: string; variant?: "check" | "dot" }
const { items, class: className = "", markClass = "text-accent", variant = "check" } = Astro.props;
---

<ul class:list={[variant === "dot" ? "space-y-2" : "space-y-3", className]}>
  {
    items.map((item) => (
      <li class="flex gap-3">
        {variant === "dot" ? (
          <span class:list={["mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-current", markClass]} aria-hidden="true" />
        ) : (
          <svg class:list={["mt-1 h-4 w-4 shrink-0", markClass]} viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2.5 8.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
          </svg>
        )}
        <span>{item}</span>
      </li>
    ))
  }
</ul>
