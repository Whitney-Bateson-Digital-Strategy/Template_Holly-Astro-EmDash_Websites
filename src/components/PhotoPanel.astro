---
/** Photo design size: 1680 x 1132 px. Full-width photo with a translucent teal panel of bullets on one side ("What's included", "What to expect"). */
import Media from "./Media.astro";
import CheckList from "./CheckList.astro";
import type { Img, Link } from "../data/types";
interface Props { title: string; subtitle?: string; bullets: string[]; cta?: Link; image: Img; panelSide?: "left" | "right" }
const { title, subtitle, bullets, cta, image, panelSide = "left" } = Astro.props;
---

<section class="relative flex min-h-[560px] items-center overflow-hidden py-16 md:min-h-[680px] md:py-24">
  <div class="absolute inset-0"><Media {...image} hideLabel /></div>
  <div class="relative w-full">
    <div
      class:list={[
        "bg-primary/90 px-6 py-10 text-paper md:w-1/2 md:py-14",
        panelSide === "left"
          ? "md:pr-12 md:pl-[max(1.25rem,calc((100vw-var(--container-site))/2))]"
          : "md:ml-auto md:pl-12 md:pr-[max(1.25rem,calc((100vw-var(--container-site))/2))]",
      ]}
    >
      <h2 class="text-paper uppercase">{title}</h2>
      {subtitle && <p class="mt-2 text-lg font-medium">{subtitle}</p>}
      <CheckList items={bullets} class="mt-5" variant="dot" />
      {cta && <a href={cta.href} class="btn mt-8">{cta.label}</a>}
    </div>
  </div>
</section>
