---
import { getTestimonials } from "../lib/cms";
interface Props { eyebrow?: string }
const { eyebrow = "Testimonials" } = Astro.props;
const testimonials = await getTestimonials();
---

<section class="section bg-sand" data-slider>
  <div class="container-site text-center">
    <p class="eyebrow-label text-accent">{eyebrow}</p>
    <div class="mx-auto mt-4 h-px w-16 bg-primary"></div>

    <div class="relative mx-auto mt-10 max-w-3xl">
      <div class="slides flex snap-x snap-mandatory overflow-x-auto scroll-smooth" data-track tabindex="0" aria-label="Client testimonials">
        {
          testimonials.map((t, i) => (
            <figure class="w-full shrink-0 snap-center px-2 md:px-10" aria-roledescription="slide" aria-label={`${i + 1} of ${testimonials.length}`}>
              <p class="eyebrow-script text-primary">{t.label}</p>
              <h2 class="mt-3 !text-2xl md:!text-3xl">{t.headline}</h2>
              <blockquote class="mt-6 text-lg leading-relaxed">“{t.quote}”</blockquote>
              <figcaption class="mt-4 eyebrow-label !text-sm text-ink/80">– {t.name}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="mt-8 flex justify-center gap-3" data-dots>
        {testimonials.map((_, i) => <button type="button" class="h-3 w-3 rounded-full bg-primary/30 aria-[current=true]:bg-primary" aria-label={`Show testimonial ${i + 1}`} aria-current={i === 0 ? "true" : "false"} data-dot={i} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .slides { scrollbar-width: none; }
  .slides::-webkit-scrollbar { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const go = (i: number) => track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" });
    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
    track.addEventListener("scroll", () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, j) => d.setAttribute("aria-current", String(i === j)));
    }, { passive: true });
  });
</script>
