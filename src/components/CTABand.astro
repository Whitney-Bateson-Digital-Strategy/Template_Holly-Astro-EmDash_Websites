---
import { ctaBand } from "../data/shared";
const { eyebrow, title, subtitle, cta } = { ...ctaBand, ...Astro.props };
---

<section class="pb-16 md:pb-20">
  <div class="container-site">
    <div class="bg-accent px-5 pt-[70px] pb-20 text-center">
      <p class="eyebrow-script text-primary">{eyebrow}</p>
      <h2 class="mt-2 uppercase text-paper">{title}</h2>
      <p class="mt-3 text-xl font-medium text-paper">{subtitle}</p>
      <a href={cta.href} class="btn btn-gold mt-8">{cta.label}</a>
    </div>
  </div>
</section>
