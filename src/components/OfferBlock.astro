---
import SplitSection from "./SplitSection.astro";
import CheckList from "./CheckList.astro";
import type { Offer } from "../data/types";
interface Props { offer: Offer; imageSide: "left" | "right" }
const { offer, imageSide } = Astro.props;
---

<SplitSection id={offer.id} image={offer.image ?? { label: offer.title }} imageSide={imageSide} class="section scroll-mt-24">
  <p class="eyebrow-label text-accent">{offer.eyebrow}</p>
  <div class="my-3 h-px w-12 bg-primary"></div>
  <h2>{offer.title}</h2>
  <p class="mt-4">{offer.description}</p>
  <h3 class="mt-8 !font-body !text-xl !not-italic font-medium">This is for you if:</h3>
  <CheckList items={offer.forYouIf} class="mt-3" />
  <h3 class="mt-8 !font-body !text-xl !not-italic font-medium">What's included:</h3>
  <CheckList items={offer.included} class="mt-3" />
  {offer.cta && <a href={offer.cta.href} class="btn mt-8 self-start">{offer.cta.label}</a>}
</SplitSection>
