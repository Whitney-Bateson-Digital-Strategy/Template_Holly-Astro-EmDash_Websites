---
/**
 * T1 V1 home hero: full-width photo (2250 x 944 design size) with a dark overlay and centered text.
 * `highlight` is the second line of the headline, shown in the accent color.
 * `media` = photo picked in EmDash (replaces image.src). `edit` = on-page editing attributes per prop.
 */
import Media from "./Media.astro";
import EditLink from "./EditLink.astro";
import type { EditAttrs, Img, Link } from "../data/types";
interface Props {
  image: Img;
  media?: unknown;
  headline: string;
  highlight?: string;
  subheadline?: string;
  cta: Link;
  edit?: Partial<Record<"image" | "headline" | "highlight" | "subheadline" | "ctaLabel" | "ctaHref", EditAttrs>>;
}
const { image, media, headline, highlight, subheadline, cta, edit = {} } = Astro.props;
---

<section class="relative isolate flex min-h-[440px] items-center md:aspect-[2250/944] md:min-h-0 md:max-h-[720px] md:w-full" {...edit.image}>
  <div class="absolute inset-0 -z-10"><Media {...image} media={media} eager hideLabel /></div>
  <div class="absolute inset-0 -z-10 bg-primary/55"></div>
  <div class="container-site py-20 text-center text-paper">
    <h1 class="mx-auto max-w-3xl text-paper">
      <span {...edit.headline}>{headline}</span>
      {highlight && <span class="block text-accent" {...edit.highlight}>{highlight}</span>}
    </h1>
    {subheadline && <p class="mx-auto mt-5 max-w-xl text-lg md:text-xl" {...edit.subheadline}>{subheadline}</p>}
    <a href={cta.href} class="btn mt-8"><span {...edit.ctaLabel}>{cta.label}</span></a>
    <EditLink attrs={edit.ctaHref} href={cta.href} class="mx-auto" />
  </div>
</section>
