---
/**
 * Edit mode only: shows where a button goes, so editors can click the address and change it on the page.
 * Renders nothing for visitors (attrs is {} outside edit mode).
 */
import type { EditAttrs } from "../data/types";
interface Props { attrs?: EditAttrs; href: string; class?: string; label?: string }
const { attrs = {}, href, class: className, label = "Button goes to:" } = Astro.props;
---

{
  Object.keys(attrs).length > 0 && (
    <p class:list={["edit-link", className]}>
      {label} <span {...attrs}>{href}</span>
    </p>
  )
}

<style>
  .edit-link {
    margin-top: 0.5rem;
    align-self: flex-start;
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 2px 10px;
    border-radius: 999px;
    background: #1a1a1a;
    color: #e0e0e0;
    font: 12px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    letter-spacing: 0;
    text-transform: none;
    overflow-wrap: anywhere;
  }
  .edit-link span {
    color: #fff;
    font-weight: 600;
  }
</style>
