---
/** Free guide sign-up: photo (1155 x 595 or taller) beside the sign-up form. The form posts to site.optin in src/site.config.ts. */
import Accent from "../Accent.astro";
import Media from "../Media.astro";
import RichText from "../RichText.astro";
import { site } from "../../site.config";
import type { SectionProps } from "./types";
const { b, e } = Astro.props as SectionProps;
const f = site.optin;
const list = Array.isArray(b.list) && b.list.length > 0;
---

<section class="bg-mist">
  <div class="grid md:grid-cols-2">
    <div class="relative h-[260px] md:h-auto md:min-h-[560px]" {...e.image("image")}>
      <div class="absolute inset-0"><Media media={b.image} label="Free guide photo" eager /></div>
    </div>
    <div class="flex items-center px-5 py-14 md:px-[8%] md:py-20">
      <div class="w-full max-w-[520px]">
        {b.eyebrow && <p class="eyebrow-script text-primary" {...e.attrs("eyebrow")}>{b.eyebrow}</p>}
        <h1 class="mt-2 uppercase" {...e.attrs("title")}><Accent text={b.title} on={e.on} /></h1>
        <RichText value={b.text} edit={e} field="text" class="mt-4 text-lg" />
        {
          (list || e.on) && (
            <>
              {b.list_title && <p class="mt-6 font-medium" {...e.attrs("list_title")}>{b.list_title}</p>}
              <RichText value={b.list} edit={e} field="list" class="mt-3" />
            </>
          )
        }
        <form action={f.action || "#"} method={f.method} class="mt-8 grid gap-3">
          <label class="sr-only" for="fg-name">First name</label>
          <input id="fg-name" class="field !bg-paper" type="text" name={f.nameField} placeholder="First Name" autocomplete="given-name" />
          <label class="sr-only" for="fg-email">Email</label>
          <input id="fg-email" class="field !bg-paper" type="email" name={f.emailField} placeholder="Email" autocomplete="email" required />
          <button class="btn" type="submit"><span {...e.attrs("button_label")}>{b.button_label || "Send me the guide"}</span></button>
        </form>
        {b.fineprint && <p class="mt-2 text-[13px] text-ink/70" {...e.attrs("fineprint")}>{b.fineprint}</p>}
      </div>
    </div>
  </div>
</section>
