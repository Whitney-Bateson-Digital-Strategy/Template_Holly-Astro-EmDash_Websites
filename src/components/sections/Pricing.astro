---
/** Pricing: payment option cards ("Invest in your health") */
import Accent from "../Accent.astro";
import Button from "../Button.astro";
import type { SectionProps } from "./types";
const { b, e } = Astro.props as SectionProps;
const plans: Record<string, string>[] = Array.isArray(b.plans) ? b.plans : [];
---

<section class="section bg-sand">
  <div class="container-site text-center">
    {b.eyebrow && <p class="eyebrow-label !text-sm text-primary" {...e.attrs("eyebrow")}>{b.eyebrow}</p>}
    {b.eyebrow && <div class="mx-auto mt-2 h-px w-16 bg-primary" />}
    <h2 class="mt-4 uppercase" {...e.attrs("title")}><Accent text={b.title} on={e.on} /></h2>
    {b.subtitle && <p class="mt-2 text-lg font-medium" {...e.attrs("subtitle")}>{b.subtitle}</p>}
    <div class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
      {
        plans.map((p, i) => {
          const pe = e.at("plans").at(i);
          return (
            <div class="bg-paper shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
              <p class="bg-primary px-6 py-4 font-script text-2xl text-accent md:text-3xl" {...pe.attrs("tag")}>{p.tag}</p>
              <div class="px-6 py-8">
                <p class="text-lg font-medium" {...pe.attrs("name")}>{p.name}</p>
                <p class="mt-3 text-lg font-bold" {...pe.attrs("price")}>{p.price}</p>
                <Button label={p.button_label} href={p.button_link} edit={pe} class="btn mt-6" linkClass="mx-auto" />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
