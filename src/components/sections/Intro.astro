---
/** Centered intro: headline, a subheading with a colored middle part, and text */
import RichText from "../RichText.astro";
import type { SectionProps } from "./types";
const { b, e, flush } = Astro.props as SectionProps;
/** Space between the subheading parts (none before punctuation) */
const gap = (s?: string) => (s && !/^[.,!?;:)]/.test(s) ? " " : "");
const hasSubtitle = b.subtitle_start || b.subtitle_highlight || b.subtitle_end;
---

<section class:list={["text-center pb-16 md:pb-20", !flush && "pt-16 md:pt-20"]}>
  <div class="container-site max-w-[900px]">
    <h2 class="uppercase" {...e.attrs("title")}>{b.title}</h2>
    {
      hasSubtitle && (
        <p class="mt-4 text-lg font-medium md:text-xl">
          <span {...e.attrs("subtitle_start")}>{b.subtitle_start}</span>{gap(b.subtitle_highlight)}<span class="text-secondary" {...e.attrs("subtitle_highlight")}>{b.subtitle_highlight}</span>{gap(b.subtitle_end)}<span {...e.attrs("subtitle_end")}>{b.subtitle_end}</span>
        </p>
      )
    }
    <RichText value={b.text} edit={e} field="text" relaxed class="mt-4" />
  </div>
</section>
