---
/** Booking calendar: intro and the booking embed (Calendly, Acuity, TidyCal…). */
import Accent from "../Accent.astro";
import RichText from "../RichText.astro";
import EditLink from "../EditLink.astro";
import { site } from "../../site.config";
import type { SectionProps } from "./types";
const { b, e, flush } = Astro.props as SectionProps;
const embed = String(b.embed_url || site.bookingEmbedUrl || "");
---

<section class:list={["pb-16 md:pb-20", !flush && "pt-16 md:pt-20"]}>
  <div class="container-site max-w-3xl text-center">
    {b.eyebrow && <p class="eyebrow-script text-accent-text" {...e.attrs("eyebrow")}>{b.eyebrow}</p>}
    {b.title && <h2 class="mt-2" {...e.attrs("title")}><Accent text={b.title} on={e.on} /></h2>}
    <RichText value={b.text} edit={e} field="text" relaxed class="mt-4" />
  </div>
  <div class="container-site mt-10 max-w-4xl">
    <EditLink attrs={e.attrs("embed_url")} href={embed || "(none yet)"} label="Calendar link:" class="mb-3" />
    {
      embed ? (
        <iframe src={embed} title="Book a call" class="h-[760px] w-full border-0" loading="lazy" />
      ) : (
        <div class="flex h-[420px] items-center justify-center border-2 border-dashed border-ink/20 bg-mist text-center text-ink/80">
          <p>Booking calendar embed goes here.<br />Add the calendar link to this section in the admin (Pages → Book a Call).</p>
        </div>
      )
    }
  </div>
</section>
