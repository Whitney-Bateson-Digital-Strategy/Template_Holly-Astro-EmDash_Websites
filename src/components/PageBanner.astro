---
/**
 * Page title band. With an image: photo + teal overlay.
 * Without one (T1 default for Contact): a solid teal band.
 * Photo design size: 2157 x 713 px.
 */
import Media from "./Media.astro";
import type { Img } from "../data/types";
interface Props { title: string; image?: Img }
const { title, image } = Astro.props;
const hasPhoto = !!image?.src;
---

<section class:list={["relative flex items-center", hasPhoto ? "min-h-[260px] md:aspect-[2157/713] md:max-h-[600px] md:min-h-0" : "min-h-[160px] bg-primary md:min-h-[220px]"]}>
  {
    hasPhoto && (
      <>
        <div class="absolute inset-0"><Media {...image} eager hideLabel /></div>
        <div class="absolute inset-0 bg-primary/55" />
      </>
    )
  }
  <div class="relative container-site py-16 text-center">
    <h1 class="text-paper">{title}</h1>
  </div>
</section>
