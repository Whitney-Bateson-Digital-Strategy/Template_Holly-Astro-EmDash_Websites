---
/** Payment option cards ("Invest in your health"). */
import type { Link } from "../data/types";
interface Props { eyebrow?: string; title: string; subtitle?: string; plans: { tag: string; name: string; price: string; cta: Link }[] }
const { eyebrow, title, subtitle, plans } = Astro.props;
---

<section class="section bg-sand">
  <div class="container-site text-center">
    {eyebrow && <p class="eyebrow-label !text-sm text-primary">{eyebrow}</p>}
    {eyebrow && <div class="mx-auto mt-2 h-px w-16 bg-primary" />}
    <h2 class="mt-4 uppercase">{title}</h2>
    {subtitle && <p class="mt-2 text-lg font-medium">{subtitle}</p>}
    <div class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
      {
        plans.map((p) => (
          <div class="bg-paper shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
            <p class="bg-primary px-6 py-4 font-script text-2xl text-accent md:text-3xl">{p.tag}</p>
            <div class="px-6 py-8">
              <p class="text-lg font-medium">{p.name}</p>
              <p class="mt-3 text-lg font-bold">{p.price}</p>
              <a href={p.cta.href} class="btn mt-6">{p.cta.label}</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
