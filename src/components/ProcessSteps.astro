---
import SplitSection from "./SplitSection.astro";
import type { Img, Step } from "../data/types";
interface Props { title: string; eyebrow: string; steps: Step[]; images: Img[] }
const { title, eyebrow, steps, images } = Astro.props;
// Two steps per row, image alternating sides
const rows: Step[][] = [];
for (let i = 0; i < steps.length; i += 2) rows.push(steps.slice(i, i + 2));
---

<section class="pt-4 text-center">
  <div class="container-site">
    <h2>{title}</h2>
    <p class="eyebrow-script mt-2 text-accent">{eyebrow}</p>
  </div>
</section>
{
  rows.map((row, r) => (
    <SplitSection image={images[r] ?? { label: `Process photo ${r + 1}` }} imageSide={r % 2 === 0 ? "right" : "left"} class="pt-6 pb-16 md:pb-20">
      <div class="space-y-10">
        {row.map((s) => (
          <div>
            <p class="eyebrow-label text-accent">{s.label}</p>
            <div class="my-3 h-px w-12 bg-primary" />
            <h3 class="!font-body !text-xl !not-italic font-medium">{s.title}</h3>
            <p class="mt-3">{s.body}</p>
          </div>
        ))}
      </div>
    </SplitSection>
  ))
}
