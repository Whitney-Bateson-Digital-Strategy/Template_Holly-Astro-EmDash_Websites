---
/**
 * Announcement bar + header. Business name, logo, announcement and header button: EmDash → Site-wide content.
 * Menu: EmDash → Menus → "Main menu" (put items under another item for a dropdown).
 */
import { Image } from "emdash/ui";
import Button from "./Button.astro";
import EditLink from "./EditLink.astro";
import { getMenuLinks, type Entry } from "../lib/cms";
interface Props { site: Entry }
const { site: siteContent } = Astro.props;
const s = siteContent.data as Record<string, any>;
const e = siteContent.edit;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const nav = (await getMenuLinks("primary")).items;
const linkClass = "text-[15px] font-bold uppercase tracking-[0.7px] no-underline transition-colors hover:text-accent";
---

{
  s.announcement_text && (
    <aside aria-label="Announcement" class="bg-primary px-5 py-2.5 text-center text-[15px] font-semibold text-paper">
      {s.announcement_link ? (
        <a href={s.announcement_link} class="no-underline hover:text-accent"><span {...e.attrs("announcement_text")}>{s.announcement_text}</span></a>
      ) : (
        <span {...e.attrs("announcement_text")}>{s.announcement_text}</span>
      )}
      <EditLink attrs={e.attrs("announcement_link")} href={s.announcement_link || "(no link)"} label="Links to:" class="mx-auto" />
    </aside>
  )
}
<header class="sticky top-0 z-40 bg-paper shadow-[0_3px_40px_rgba(0,0,0,0.15)]">
  <div class="container-site flex items-center justify-between gap-6 py-4">
    <a href="/" class="shrink-0 no-underline" aria-label={`${s.brand_name} home`}>
      {
        s.logo ? (
          <span class="block" {...e.image("logo")}><Image image={s.logo} class="!h-12 !w-auto" priority /></span>
        ) : (
          <span class="font-display text-2xl tracking-tight text-primary" {...e.attrs("brand_name")}>{s.brand_name}</span>
        )
      }
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 lg:flex">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => {
            const active = isActive(item.href) || !!item.children?.some((c) => isActive(c.href));
            return item.children?.length ? (
              <li class="group relative">
                <a href={item.href} class:list={[linkClass, "inline-flex items-center gap-1", active ? "text-primary" : "text-[#434343]"]} aria-current={isActive(item.href) ? "page" : undefined} aria-haspopup="true">
                  {item.label}
                  <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
                </a>
                <div class="invisible absolute top-full left-1/2 z-50 -translate-x-1/2 pt-4 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                  <ul class="min-w-[220px] bg-paper shadow-[0_8px_30px_rgba(0,0,0,0.12)]">
                    {item.children.map((c, n) => (
                      <li>
                        <a href={c.href} class:list={["block px-5 py-3 text-sm font-bold uppercase tracking-[0.7px] no-underline hover:bg-mist hover:text-secondary", n > 0 && "border-t border-ink/10", isActive(c.href) ? "text-primary" : "text-[#434343]"]} aria-current={isActive(c.href) ? "page" : undefined}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={[linkClass, active ? "text-primary" : "text-[#434343]"]} aria-current={active ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <Button label={s.header_button_label} href={s.header_button_link} edit={e} labelField="header_button_label" linkField="header_button_link" class="btn !py-3" />
    </nav>

    <details class="mobile-nav relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 p-2 text-sm uppercase tracking-[0.7px]" aria-label="Open menu">
        <span aria-hidden="true" class="flex w-6 flex-col gap-1.5">
          <span class="h-0.5 w-full bg-ink"></span><span class="h-0.5 w-full bg-ink"></span><span class="h-0.5 w-full bg-ink"></span>
        </span>
        Menu
      </summary>
      <nav aria-label="Mobile" class="absolute right-0 mt-3 w-64 bg-paper p-6 shadow-lg">
        <ul class="space-y-4">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block uppercase tracking-[0.7px] no-underline" aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
                {item.children.length > 0 && (
                  <ul class="mt-3 space-y-3 border-l border-ink/15 pl-4">
                    {item.children.map((c) => (
                      <li><a href={c.href} class="block text-sm uppercase tracking-[0.7px] no-underline" aria-current={isActive(c.href) ? "page" : undefined}>{c.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        {s.header_button_label && <a href={s.header_button_link || "#"} class="btn mt-6 w-full">{s.header_button_label}</a>}
      </nav>
    </details>
  </div>
</header>

<style>
  .mobile-nav summary::-webkit-details-marker { display: none; }
</style>
