---
import Media from "./Media.astro";
import { optin } from "../data/shared";
import { site } from "../site.config";
const f = site.optin;
---

{
  optin.show && (
    <section id="optin" class="scroll-mt-24">
      <div class="grid md:grid-cols-2">
        <div class="order-2 flex items-center justify-center bg-[#f4f8fc] px-5 py-[60px] md:order-1">
          <div class="w-full max-w-[520px] text-center">
            <p class="eyebrow-script text-accent">{optin.eyebrow}</p>
            <h2 class="mt-2 text-primary">{optin.title}</h2>
            <p class="mt-2 font-display text-lg italic text-ink">{optin.subtitle}</p>
            <p class="mt-4 text-lg">{optin.body}</p>
            <form action={f.action || "#"} method={f.method} class="mt-6 grid gap-3 pt-5 pb-2.5">
              <label class="sr-only" for="optin-name">First name</label>
              <input id="optin-name" class="field !bg-paper" type="text" name={f.nameField} placeholder="First Name" autocomplete="given-name" />
              <label class="sr-only" for="optin-email">Email</label>
              <input id="optin-email" class="field !bg-paper" type="email" name={f.emailField} placeholder="Email" autocomplete="email" required />
              <button class="btn" type="submit">{optin.button}</button>
            </form>
            {optin.fineprint && <p class="mt-2 text-[13px] text-ink/70">{optin.fineprint}</p>}
          </div>
        </div>
        <div class="order-1 min-h-[280px] md:order-2 md:min-h-[520px]">
          <Media {...optin.image} />
        </div>
      </div>
    </section>
  )
}
