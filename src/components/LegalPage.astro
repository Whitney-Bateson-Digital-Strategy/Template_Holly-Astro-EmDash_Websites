---
/** Simple text page for the legal links in the footer. Copy lives in `legal` (src/data/pages.ts). */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "./PageBanner.astro";
interface Props { title: string; updated?: string; paragraphs: string[] }
const { title, updated, paragraphs } = Astro.props;
---

<BaseLayout title={title}>
  <PageBanner title={title} />
  <section class="section">
    <div class="container-site max-w-3xl">
      {updated && <p class="text-sm text-ink/70">Last updated: {updated}</p>}
      {
        paragraphs.map((t) =>
          t.startsWith("## ") ? <h2 class="mt-10 !font-body !text-xl font-medium">{t.slice(3)}</h2> : <p class="mt-4 leading-relaxed">{t}</p>,
        )
      }
    </div>
  </section>
</BaseLayout>
