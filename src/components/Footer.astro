---
import OptIn from "./OptIn.astro";
import { site } from "../site.config";
import { footer } from "../data/shared";
const year = new Date().getFullYear();
const initials: Record<string, string> = { Instagram: "IG", Facebook: "FB", LinkedIn: "in", YouTube: "YT", TikTok: "TT", Pinterest: "P" };
---

<OptIn />

<footer>
  <!-- Main footer: sand -->
  <div class="bg-sand py-[30px]">
    <div class="container-site grid gap-10 py-8 md:grid-cols-[52%_1fr_1fr]">
      <div class="md:pr-[14%]">
        {
          site.logo ? (
            <img src={site.logo} alt={site.logoAlt} class="w-1/2 min-w-[160px]" />
          ) : (
            <p class="font-display text-2xl text-primary">{site.name}</p>
          )
        }
        <p class="mt-4 text-ink">{footer.blurb}</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="!font-body !text-xl font-medium text-primary">{footer.linksTitle}</h2>
        <ul class="mt-4 space-y-1">
          {site.nav.map((item) => <li><a href={item.href} class="text-ink no-underline transition-colors hover:text-secondary">{item.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="!font-body !text-xl font-medium text-primary">{footer.socialTitle}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            site.socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-xs font-bold text-paper no-underline transition-colors hover:bg-secondary"
                >
                  {initials[s.label] ?? s.label.slice(0, 2)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar: gold -->
  <div class="bg-gold py-5 text-paper">
    <div class="container-site text-center">
      <ul class="flex flex-wrap justify-center gap-y-1 text-xs font-semibold uppercase tracking-wide">
        {
          site.footerLinks.map((l, i) => (
            <li class:list={["px-2.5", i > 0 && "border-l border-[#ddd]"]}>
              <a href={l.href} class="no-underline hover:text-secondary">{l.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 text-[13px] font-medium leading-[22px]">© {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
