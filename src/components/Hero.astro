---
/** T1 hero: photo band with a white card that overlaps its bottom edge. */
import Media from "./Media.astro";
import type { Img, Link } from "../data/types";
interface Props { image: Img; headline: string; subheadline?: string; cta: Link }
const { image, headline, subheadline, cta } = Astro.props;
---

<section class="relative pb-4">
  <div class="absolute inset-x-0 top-0 h-[260px] md:h-[340px]"><Media {...image} eager hideLabel /></div>
  <div class="relative container-site pt-28 md:pt-[130px]">
    <div class="mx-auto max-w-[920px] bg-paper px-6 py-12 text-center shadow-[0_10px_40px_rgba(0,0,0,0.10)] md:px-16 md:py-14">
      <h1 class="mx-auto max-w-2xl text-ink">{headline}</h1>
      {subheadline && <p class="mx-auto mt-4 max-w-xl text-lg md:text-xl">{subheadline}</p>}
      <a href={cta.href} class="btn mt-8">{cta.label}</a>
    </div>
  </div>
</section>
