---
/**
 * Blog sidebar.
 * 1. Widgets managed in the EmDash admin: bio (Content widget), Recent Posts, Categories, etc.
 * 2. A freebie box with a real Kit form (src/data/shared.ts -> sidebarFreebie).
 */
import { getWidgetAreas } from "emdash";
import { WidgetArea } from "emdash/ui";
import Media from "./Media.astro";
import { sidebarFreebie as fb } from "../data/shared";
import { site } from "../site.config";

const PREFERRED = ["blog-sidebar", "sidebar"];
let areaName: string | undefined;
try {
  const areas = await getWidgetAreas();
  areaName = PREFERRED.find((n) => areas.some((a) => a.name === n)) ?? areas[0]?.name;
} catch (e) {
  console.error("[sidebar]", e);
}
const f = site.optin;
---

<aside class="blog-sidebar space-y-8" aria-label="Sidebar">
  {
    fb.show && (
      <section class="bg-primary p-6 text-center text-paper">
        <div class="mb-4 h-40"><Media {...fb.image} /></div>
        <p class="eyebrow-script !text-[2rem] text-accent">{fb.eyebrow}</p>
        <h2 class="mt-1 !text-2xl text-paper">{fb.title}</h2>
        <p class="mt-3 text-[15px] text-paper/85">{fb.body}</p>
        <form action={f.action || "#"} method={f.method} class="mt-5 grid gap-2">
          <label class="sr-only" for="sb-name">First name</label>
          <input id="sb-name" class="field !bg-paper" type="text" name={f.nameField} placeholder="First Name" autocomplete="given-name" />
          <label class="sr-only" for="sb-email">Email</label>
          <input id="sb-email" class="field !bg-paper" type="email" name={f.emailField} placeholder="Email" autocomplete="email" required />
          <button class="btn w-full" type="submit">{fb.button}</button>
        </form>
      </section>
    )
  }
  {areaName && <WidgetArea name={areaName} class="space-y-8" />}
</aside>

<style is:global>
  .blog-sidebar .widget { background: var(--color-sand); padding: 1.5rem; }
  .blog-sidebar .widget__title { font-family: var(--font-body); font-style: normal; font-weight: 500; font-size: 1.1875rem; letter-spacing: 0.72px; text-transform: uppercase; color: var(--color-primary); margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent); }
  .blog-sidebar .widget__content p { margin-bottom: 0.75rem; }
  .blog-sidebar .widget__content img { width: 100%; height: auto; margin-bottom: 0.75rem; }
  .blog-sidebar .widget__content a { text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 4px; }
  .blog-sidebar .widget__content ul { list-style: none; padding: 0; }
  .blog-sidebar .widget__content li { padding: 0.5rem 0; border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent); }
  .blog-sidebar .widget__content li:last-child { border-bottom: 0; }
  .blog-sidebar .widget__content li a { text-decoration: none; }
  .blog-sidebar .widget__content time { display: block; font-size: 0.8rem; opacity: 0.65; }
</style>
